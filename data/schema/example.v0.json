{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Example record (v0)",
  "description": "Trivial schema that exercises the schema-validation scaffold. Not a published format.",
  "type": "object",
  "required": ["schema_version", "count"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "example.v0" },
    "count": { "type": "integer", "minimum": 0 },
    "note": { "type": "string", "maxLength": 200 }
  }
}
