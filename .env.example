# Engine environment: development (default), test or production.
WEARREPORT_ENV=
# TfL Unified API app key, from https://api-portal.tfl.gov.uk/.
TFL_APP_KEY=
# Met Office Weather DataHub API key.
METOFFICE_API_KEY=
# User-Agent for the US National Weather Service API; must include a contact address.
NWS_USER_AGENT=
# Local development only: set to openmeteo to use Open-Meteo instead of the Met Office.
WEARREPORT_DEV_WEATHER=
# Judge bake-off only (never CI): an Amazon Bedrock API key. Leave empty when the
# environment adds the credential itself; DeepInfra needs no variable (see README).
AWS_BEARER_TOKEN_BEDROCK=
